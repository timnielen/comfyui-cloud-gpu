# Cloud Run credentials. Copy to .env (gitignored); see the README for where each value comes from.
RUNPOD_API_KEY=

# Optional bucket, all four lines or none. Without it, files travel through RunPod (inputs up to ~7 MB per run).
# If you use one, add the same BUCKET_* lines to your RunPod endpoint's environment variables.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_KEY=
BUCKET_SECRET=
