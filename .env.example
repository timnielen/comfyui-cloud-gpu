# Cloud Run credentials. Copy to .env (gitignored); see the README for where each value comes from.
# Also add the BUCKET_* lines to your RunPod endpoint's environment variables. RUNPOD_API_KEY stays local.
RUNPOD_API_KEY=
BUCKET_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BUCKET_NAME=
BUCKET_KEY=
BUCKET_SECRET=
